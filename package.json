{
  "name": "indian-food-recommends",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Where Indian food vloggers say to eat, ranked by distinct creators, with the source moment.",
  "homepage": "https://indian-food-recommends.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piyush97/IndianFoodRecommends.git"
  },
  "bugs": {
    "url": "https://github.com/piyush97/IndianFoodRecommends/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx db/seed.ts",
    "worker": "tsx worker/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:seed": "tsx e2e/seed.ts",
    "eval:area": "vitest run eval/area-eval.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@vercel/otel": "^2.3.0",
    "botid": "^1.5.13",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.17.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4",
    "@playwright/test": "1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "prettier": "3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "esbuild@<=0.24.2": "^0.25.0"
    }
  }
}
