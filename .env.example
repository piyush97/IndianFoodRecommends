# Copy to .env and fill in. Never commit .env.
# Postgres (Neon/Supabase/local Docker). Migrations: pnpm db:migrate
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ifr

# YouTube Data API v3 key (Google Cloud, free quota).
YOUTUBE_API_KEY=

# LLM extraction via cliproxyapi, which speaks the OpenAI chat API.
OPENAI_BASE_URL=http://localhost:8317/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Admin auth (Auth.js). Secret: `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# Nominatim requires an identifying User-Agent with contact details.
NOMINATIM_USER_AGENT=indianfoodrecommends/0.1 (you@example.com)

NEXT_PUBLIC_SITE_URL=http://localhost:3000
