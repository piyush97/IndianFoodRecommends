# Copy to .env and fill in. Never commit .env.
# Postgres (Neon/Supabase/local). Migrations: pnpm db:migrate
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ifr
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/ifr_test

# LLM: cliproxyapi on this machine, OpenAI-compatible API.
LLM_BASE_URL=http://localhost:8317/v1
LLM_API_KEY=
LLM_MODEL=

# Optional: Jev classifier (https://console.typesafe.ai/keys). Skips videos with no
# Delhi food place before the LLM runs. Unset = every video goes to the LLM.
TYPESAFE_API_KEY=

# Auth.js. Secret: `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# Nominatim needs a descriptive User-Agent with a contact email.
NOMINATIM_USER_AGENT=indianfoodrecommends/0.1 (you@example.com)

# Salt for hashing reporter IPs (`openssl rand -hex 32`). Required for /api/report.
REPORT_SALT=
# Shown in the footer for creator opt-out requests. Unset = "coming soon" text.
NEXT_PUBLIC_OPTOUT_EMAIL=

# Worker → site cache refresh after approvals (`openssl rand -hex 32`, same value in Vercel).
REVALIDATE_SECRET=
SITE_URL=https://indian-food-recommends.vercel.app

# Optional cookieless analytics (cloud.umami.is, free Hobby plan). Unset = no script.
# Production: set in Vercel (see docs/metrics.md, "Setup (owner)").
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Absolute URL for canonical tags, share links and OG images. Production: https://indian-food-recommends.vercel.app until a domain exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: live Google Maps star ratings on place pages (Places API (New), server-side only).
# Restrict the key to the Places API; cap usage in Google Cloud quotas. Unset = no ratings.
GOOGLE_MAPS_API_KEY=
