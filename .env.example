# Copy to .env and fill in. Never commit .env.
#
# Postgres (Neon, Supabase or local). Migrations: pnpm db:migrate
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ifr
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/ifr_test

# LLM: any OpenAI-compatible endpoint. Extraction runs only in the worker, never in the web app.
LLM_BASE_URL=http://localhost:8317/v1
LLM_API_KEY=
LLM_MODEL=

# Verifier (https://console.typesafe.ai/keys). Without it, picks stay pending; the LLM still runs.
TYPESAFE_API_KEY=

# Auth.js. Secret: `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated allowed for /admin.
ADMIN_EMAILS=

# Nominatim User-Agent. Use a real contact address, as OSM asks.
NOMINATIM_USER_AGENT=indianfoodrecommends/0.1 (you@example.com)

# Salt for hashing reporter IPs (`openssl rand -hex 32`). Required by /api/report.
REPORT_SALT=
# Shown for creator opt-out requests. Unset shows "coming soon".
NEXT_PUBLIC_OPTOUT_EMAIL=

# Worker to site cache revalidation (`openssl rand -hex 32`, set the same value in Vercel).
REVALIDATE_SECRET=
SITE_URL=https://indian-food-recommends.vercel.app

# Optional analytics (cloud.umami.is, Hobby plan). Unset records nothing.
# Production setup checklist: docs/metrics.md.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Canonical URL for metadata tags, share links and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google ratings on place pages (Places API (New), server-side only).
# Without a key the rating line is simply absent.
GOOGLE_MAPS_API_KEY=
