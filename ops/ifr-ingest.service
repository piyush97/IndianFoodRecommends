[Unit]
Description=IndianFoodRecommends daily ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Projects/IndianFoodRecommends
EnvironmentFile=/root/Projects/IndianFoodRecommends/.env
Environment=YTDLP_BIN=/root/.local/bin/yt-dlp
ExecStart=/usr/bin/env pnpm worker ingest
