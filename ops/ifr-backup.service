[Unit]
OnFailure=ifr-alert@%n.service
Description=IndianFoodRecommends nightly database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/Projects/IndianFoodRecommends
# Only the production DB URL: the backup needs nothing else from .env.
EnvironmentFile=/etc/ifr/backup.env
ExecStart=/usr/bin/env bash ops/backup.sh
ProtectSystem=strict
ReadWritePaths=/var/backups/ifr
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
